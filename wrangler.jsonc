{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meway-discord-activity",
  "compatibility_date": "2026-10-01",
  "main": "worker.ts",
  "keep_vars": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "DISCORD_CLIENT_ID": "1555208386742587444",
    "ADMIN_DISCORD_ID": "715131938368651294",
    "DISCORD_GUILD_ID": "1554179282513829998"
  },
  "previews": {
  "vars": {
    "DISCORD_CLIENT_ID": "0",
    "ADMIN_DISCORD_ID": "0",
    "DISCORD_GUILD_ID": "0"
  }
},


"d1_databases": [
  {
    "binding": "DB",
    "database_name": "meway-content",
    "database_id": "7e8ce092-667f-4cb0-a9b2-a94cea799ef8"
  }
]
}
