ate"],"type":"input"},{"id":5,"question":"Вспомни английский эквивалент «согласованность политики». В ответе 15 букв (без учёта пробелов и знаков).","options":[],"correctAnswer":"policy coherence","explanation":"“policy coherence” — «согласованность политики».","acceptedAnswers":["policy coherence"],"type":"input"}]},{"id":5343,"title":"C2 Mission Plus 44: Advanced economics","description":"Смешанная практика уровня C2 по теме «Advanced economics»: значение, распознавание, написание и точность употребления.","category":"Словарный запас","level":"C2","xp":65,"icon":"🎯","duration":"7 мин","status":"published","tasks":[{"id":1,"question":"Выбери точный перевод слова или выражения “income distribution”.","options":["распределение доходов","повествовательная структура","допустимый уровень риска","процедурная гарантия"],"correctAnswer":"распределение доходов","explanation":"“income distribution” — «распределение доходов».","acceptedAnswers":["income distribution"],"type":"choice"},{"id":2,"question":"Какое английское слово или выражение соответствует «экономический спад»?","options":["scrutiny","syntactic variety","economic downturn","narrative voice"],"correctAnswer":"economic downturn","explanation":"“economic downturn” — «экономический спад».","acceptedAnswers":["economic downturn"],"type":"choice"},{"id":3,"question":"Верно ли утверждение: “productivity growth” означает «опровержение»?","options":["Верно","Неверно"],"correctAnswer":"Неверно","explanation":"“productivity growth” — «рост производительности».","acceptedAnswers":["productivity growth"],"type":"true-false"},{"id":4,"question":"Какая пара правильно передаёт значение слова или выражения «capital allocation»?","options":["pragmatics — регистр речи","comprehensive — рыночная волатильность","feasibility — повествовательная неоднозначность","capital allocation — распределение капитала"],"correctAnswer":"capital allocation — распределение капитала","explanation":"“capital allocation” — «распределение капитала».",