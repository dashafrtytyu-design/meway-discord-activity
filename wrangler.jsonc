{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meway-discord-activity",
  "compatibility_date": "2026-10-01",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1555208386742587444"
  },
  "secrets": {
    "required": ["DISCORD_CLIENT_SECRET", "ADMIN_DISCORD_ID"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meway-content"
    }
  ]
}
