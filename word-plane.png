d":4,"question":"Выбери единственное верное утверждение о слове или выражении «thematic coherence».","options":["“thematic coherence” означает «тематическая связность»","“external validity” означает «суверенитет»","“discourse convention” означает «научный консенсус»","“articulate a position” означает «предварительный»"],"correctAnswer":"“thematic coherence” означает «тематическая связность»","explanation":"“thematic coherence” — «тематическая связность».","acceptedAnswers":["thematic coherence"],"type":"choice"},{"id":5,"question":"Напиши английское слово/выражение со значением «лаконичность выражения». Первая буква: E.","options":[],"correctAnswer":"economy of expression","explanation":"“economy of expression” — «лаконичность выражения».","acceptedAnswers":["economy of expression"],"type":"input"},{"id":6,"question":"Вспомни английский эквивалент «намеренное усиление». В ответе 18 букв (без учёта пробелов и знаков).","options":[],"correctAnswer":"deliberate emphasis","explanation":"“deliberate emphasis” — «намеренное усиление».","acceptedAnswers":["deliberate emphasis"],"type":"input"},{"id":7,"question":"Выбери точный перевод слова или выражения “discursive essay”.","options":["дискурсивное эссе","прагматическое следствие","причинность","синтаксическое разнообразие"],"correctAnswer":"дискурсивное эссе","explanation":"“discursive essay” — «дискурсивное эссе».","acceptedAnswers":["discursive essay"],"type":"choice"},{"id":8,"question":"Какое английское слово или выражение соответствует «стилистическая последовательность»?","options":["stylistic consistency","feasibility","regulatory compliance","scrutiny"],"correctAnswer":"stylistic consistency","explanation":"“stylistic consistency” — «стилистическая последовательность».","acceptedAnswers":["stylistic consistency"],"type":"choice"},{"id":9,"question":"Верно ли утверждение: “lexical precision” означает «сопоставление»?","options":["Верно","Неверно"],"correctAnswer":"Неверно","explanation":"“lexical precision” — «лексическая точность».","acceptedAnswers":["lexical precision"],"type":"true-false"}]},{"id":5305,"title":"C2 Mission Plus 6: Advanced linguistics","description":"Смешанная практика уровня C2 по теме «Advanced linguistics»: значение, распознавание, написание и точность употребления.","category":"Словарный запас","level":"C2","xp":75,"icon":"🎯","duration":"11 мин","status":"published","tasks":[{"id":1,"question":"Какая пара правильно передаёт значение слова или выражения «figurative meaning»?","options":["collocation — аналитическая точность","figurative meaning — переносное значение","productivity growth — опровергать аргумент","qualified claim — причинный вывод"],"correctAnswer":"figurative meaning — переносное значение","explanation":"“figurative meaning” — «переносное значение».","acceptedAnswers":["figurative meaning"],"type":"choice"},{"id":2,"question":"В какой паре слово или выражение «implicit meaning» переведено неверно?","options":["ambiguity — неоднозначность","fallacy — логическая ошибка","nuance — нюанс","implicit meaning — чётко очерчивать"],"correctAnswer":"implicit meaning — чётко очерчивать","explanation":"Неверная пара исправляется так: “implicit meaning” — «имплицитное значение».","acceptedAnswers":["implicit meaning"],"type":"choice"},{"id":3,"question":"Напиши по-английски: «идиоматичность».","options":[],"correctAnswer":"idiomaticity","explanation":"“idiomaticity” — «идиоматичность».","acceptedAnswers":["idiomaticity"],"type":"input"},{"id":4,"question":"Собери английское слово или выражение из перемешанных букв: tcsoilisicuoign / atravioni. Подсказка: «социолингвистическая вариативность».","options":[],"correctAnswer":"sociolinguistic variation","explanation":"“sociolinguistic variation” — «социолингвистическая вариативность».","acceptedAnswers":["sociolinguistic variation"],"type":"input"},{"id":5,"question":"Восстанови пропущенные буквы: c_n_e_t_a_ c_e. Значение: «контекстуальная подсказка».","options":[],"correctAnswer":"contextual cue","explanation":"“contextual cue” — «контекстуальная подсказка».","acceptedAnswers":["contextual cue"],"type":"input"},{"id":6,"question":"Какой вариант нужно выбрать, если требуется английский эквивалент «прагматический вывод»?","options":["critical interpretation","discursive strategy","model specification","pragmatic inference"],"correctAnswer":"pragmatic inference","explanation":"“pragmatic inference” — «прагматический вывод».","acceptedAnswers":["pragmatic inference"],"type":"choice"},{"id":7,"question":"Выбери единственное верное утверждение о слове или выражении «semantic ambiguity».","options":["“semantic ambiguity” означает «семантическая неоднозначность»","“draw a subtle distinction” означает «неоднозначность»","“rhetorical structure” означает «риторическая позиция»","“lexical precision” означает «стратегическое согласование»"],"correctAnswer":"“semantic ambiguity” означает «семантическая неоднозначность»","explanation":"“semantic ambiguity” — «семантическая неоднозначность».","acceptedAnswers":["semantic ambiguity"],"type":"choice"},{"id":8,"question":"Напиши английское слово/выражение со значением «смена регистра». Первая буква: R.","options":[],"correctAnswer":"register shift","explanation":"“register shift” — «смена регистра».","acceptedAnswers":["register shift"],"type":"input"},{"id":9,"question":"Вспомни английский эквивалент «дискурсивная конвенция». В ответе 19 букв (без учёта пробелов и знаков).","options":[],"correctAnswer":"discourse convention","explanation":"“discourse convention” — «дискурсивная конвенция».","acceptedAnswers":["discourse convention"],"type":"input"},{"id":10,"question":"Выбери точный перевод слова или выражения “lexical choice”.","options":["риторический приём","согласованность политики","лексический выбор","финансовый рычаг"],"correctAnswer":"лексический выбор","explanation":"“lexical choice” — «лексический выбор».","acceptedAnswers":["lexical choice"],"type":"choice"}]},{"id":5306,"title":"C2 Mission Plus 7: Governance and institu